      ]
    },
    {
      "effect": "solid",
      "params": {
        "color": "#00a8ff"
      },
      "keys": [
        "@numbers"
      ]
    },
    {
      "effect": "solid",
      "params": {
        "color": "#ff8a00"
      },
      "keys": [
        "@fn_row"
      ]
    },
    {
      "effect": "solid",
      "params": {
        "color": "#00ff9a"
      },
      "keys": [
        "@arrows",
        "@nav"
      ]
    },
    {
      "effect": "reactive",
      "params": {
        "colors": [
          "#ffffff"
        ],
        "style": "key",
        "duration": 0.5
      }
    }
  ]
